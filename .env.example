# Server-side secrets only. Never prefix these with VITE_.
GEMINI_API_KEY=
GROQ_API_KEY=
# auto tries Gemini then Groq for text. Images require Gemini.
AI_PROVIDER=auto
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase is used by the Express server only. Never expose the secret key to Vite.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PORT=3000
HOST=127.0.0.1
